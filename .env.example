OLLAMA_HOST=http://127.0.0.1:11434
VISION_MODEL=qwen2.5vl:7b
PLANNER_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
MAX_VISION_STEPS=12
MAX_VISION_STEPS_INSTALL=20
VISION_STALL_LIMIT=3
ACTION_PAUSE=0.35
# Seconds to wait for a page/app to load before vision starts clicking
PAGE_LOAD_WAIT=0.6
POST_CLICK_DELAY=0.2
INSTALLER_OPEN_WAIT=1.0
# Keep models loaded between steps (avoids reload lag). Set 0 to unload immediately.
OLLAMA_KEEP_ALIVE=10m
# SAVE_SCREENSHOTS=1
# Lower = more deterministic. Planner plans; vision clicks.
PLANNER_TEMPERATURE=0.3
VISION_TEMPERATURE=0.1
VISION_MAX_WIDTH=1280
# Lower = smaller images to Ollama = faster (65–82). Default 72.
VISION_JPEG_QUALITY=72
# Cap JSON output length — vision only needs a short reply
OLLAMA_NUM_PREDICT=160
# Grid pointing: max image width + optional single-stage (skip 2nd vision call)
GRID_MAX_WIDTH=960
# GRID_SINGLE_STAGE=1
OCR_MAX_WIDTH=1280
# Coarse-to-fine clicking: zoom in to pinpoint targets (more accurate, +1 model call per click)
REFINE_CLICKS=1
REFINE_FRAC=0.34
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
# MIC_DEVICE_INDEX=1
VOICE_MODE=1
TTS_RATE=175
TTS_VOLUME=1.0
TTS_VOICE=
LISTEN_TIMEOUT=10
PHRASE_LIMIT=20
USE_UI_TREE=1
UI_TREE_BUDGET=1.2
# UIA-first (Windows-Use style): accessibility tree + text LLM, no screenshots
UIA_FIRST=1
UIA_MIN_ELEMENTS=4
MAX_UIA_STEPS=12
VISION_FALLBACK=1
# Animated cursor + click ring (Clicky-style human feel)
CURSOR_ANIMATE=1
CURSOR_MOVE_DURATION=0.35
SHOW_CLICK_RING=1
# UIA → OCR → grid pointing when vision model coords miss
USE_HYBRID_POINTER=1
USE_GRID_LOCATOR=1
